{
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 -I ./skills/prime-developer-security/scripts/prime_hooks.py session",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": "python3 -I ./skills/prime-developer-security/scripts/prime_hooks.py file",
        "matcher": "Read|Write",
        "timeout": 5
      }
    ]
  }
}
