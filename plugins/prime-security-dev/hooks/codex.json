{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${PLUGIN_ROOT}/skills/prime-developer-security/scripts/prime_hooks.py\" session",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${PLUGIN_ROOT}/skills/prime-developer-security/scripts/prime_hooks.py\" file",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
